{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "testHP/user-input-contract/v1",
  "title": "testHP User Input Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "subject", "acquisition", "inputs"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id"],
      "properties": {
        "subject_id": {"type": "string", "minLength": 1},
        "sex": {"enum": ["female", "male", "intersex", "unknown", "not_disclosed"]},
        "birth_year": {"type": ["integer", "null"], "minimum": 1800},
        "metadata": {"type": "object"}
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timepoint_id", "acquisition_time", "laterality"],
      "properties": {
        "timepoint_id": {"type": "string", "minLength": 1},
        "acquisition_time": {"type": "string", "format": "date-time"},
        "laterality": {"enum": ["left", "right", "bilateral", "unknown"]},
        "operator_id": {"type": ["string", "null"]},
        "site_id": {"type": ["string", "null"]},
        "metadata": {"type": "object"}
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/input"}
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type"],
      "properties": {
        "source_type": {"enum": ["user", "clinical", "research_dataset", "derived"]},
        "source_id": {"type": ["string", "null"]},
        "license": {"type": ["string", "null"]},
        "checksum_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "kind", "uri", "format", "provenance"],
      "properties": {
        "input_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["hand_images", "hand_video", "hand_3d", "tissue_wsi", "microscopy", "single_cell_rna", "bulk_rna", "genomics", "proteomics", "epigenetics", "clinical_context", "ground_truth"]},
        "uri": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"},
        "metadata": {"type": "object"},
        "quality": {"type": "object"},
        "ground_truth": {"type": ["object", "null"]}
      }
    }
  }
}
